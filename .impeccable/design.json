      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 18px;border:1px solid var(--kw-action,#244ac2);border-radius:8px;font-family:var(--kw-font-body,\"Segoe UI\",\"Microsoft JhengHei\",system-ui,sans-serif);font-size:.95rem;line-height:1.65;font-weight:600;text-decoration:none;white-space:nowrap;cursor:pointer;transition:background-color 180ms ease-out;background:var(--kw-white,#fff);color:var(--kw-action,#244ac2)}.ds-button-secondary:hover{background:var(--kw-soft,#edf1f7);color:var(--kw-action,#244ac2)}.ds-button-secondary[aria-pressed=\"true\"]{background:var(--kw-action,#244ac2);color:var(--kw-white,#fff)}.ds-button-secondary:focus-visible{outline:3px solid var(--kw-action,#244ac2);outline-offset:3px;}.ds-button-secondary:disabled{background:#e8ebf0;color:#667181;border-color:#c9d0da;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none}}"
