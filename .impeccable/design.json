      "css": ".ds-nav{display:flex;align-items:center;gap:26px;font-family:var(--kw-font-body,\"Segoe UI\",\"Microsoft JhengHei\",system-ui,sans-serif);font-size:16px;line-height:1.65}.ds-nav a{color:var(--kw-muted-strong,#46566c);text-decoration:none;padding:24px 0;position:relative;white-space:nowrap}.ds-nav a:hover{color:var(--kw-action,#244ac2)}.ds-nav a[aria-current=\"page\"]{color:var(--kw-action,#244ac2);font-weight:650}.ds-nav a[aria-current=\"page\"]::after{content:\"\";height:3px;background:var(--kw-action,#244ac2);position:absolute;bottom:0;left:0;right:0}.ds-nav a:focus-visible{outline:3px solid var(--kw-action,#244ac2);outline-offset:3px;}@media(max-width:1050px){.ds-nav{gap:12px;flex-wrap:wrap}.ds-nav a{padding:8px 0}}@media(max-width:700px){.ds-nav a{font-size:.875rem;min-height:44px;display:flex;align-items:center}}"
