{
  "name": "kwmpf",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "check": "bun run format:check && bun run check:shell && bun run typecheck && bun run test && bun run build",
    "check:shell": "bash -n scripts/*.sh && bash scripts/test-render-staging-config.sh",
    "coverage:build": "bun packages/coverage/src/cli.ts",
    "coverage:first-batch": "bun packages/coverage/src/build-first-batch.ts",
    "coverage:fetch-platform": "bun packages/coverage/src/fetch-platform.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
