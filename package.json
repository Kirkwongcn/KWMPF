{
  "name": "kwmpf",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "check": "bun run format:check && bun run check:shell && bun run typecheck && bun run test && bun run build",
    "check:shell": "bash -n scripts/*.sh && bash scripts/test-render-staging-config.sh",
    "coverage:build": "bun packages/coverage/src/cli.ts",
    "coverage:first-batch": "bun packages/coverage/src/build-first-batch.ts",
    "coverage:second-batch": "bun packages/coverage/src/build-second-batch.ts",
    "coverage:remaining-batch": "bun packages/coverage/src/build-remaining-batch.ts",
    "coverage:merge-fact-sheets": "bun packages/coverage/src/merge-fact-sheet-returns.ts",
    "coverage:fact-sheet-index": "bun packages/coverage/src/build-fact-sheet-index.ts",
    "coverage:fetch-fact-sheets": "bun packages/coverage/src/fetch-fact-sheets.ts",
    "coverage:parse-fact-sheets": "bun packages/coverage/src/parse-fact-sheets.ts",
    "coverage:build-return-overlay": "bun packages/coverage/src/build-return-overlay.ts",
    "coverage:build-comparison-evidence": "bun packages/coverage/src/build-comparison-evidence.ts",
    "coverage:build-candidate-ranking-report": "bun packages/coverage/src/build-candidate-ranking-report.ts",
    "coverage:build-candidate-audit-report": "bun packages/coverage/src/build-candidate-audit-report.ts",
    "coverage:fetch-platform": "bun packages/coverage/src/fetch-platform.ts",
    "coverage:retry-platform": "bun packages/coverage/src/retry-platform.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
